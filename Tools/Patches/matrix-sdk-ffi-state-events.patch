+    /// Fetch the content of an account data event directly from the homeserver.
+    pub async fn fetch_account_data(&self, event_type: String) -> Result<Option<String>, ClientError> {
+        let event = self.inner.account().fetch_account_data(event_type.into()).await?;
+        Ok(event.map(|e| e.json().get().to_owned()))
