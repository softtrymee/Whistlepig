+    /// Fetch all room state events directly from the homeserver as JSON strings.
+    pub async fn fetch_state_events_raw(&self, room_id: String) -> Result<Vec<String>, ClientError> {
+        let room_id = RoomId::parse(room_id)?;
+        let response = self.inner.send(get_state_events::v3::Request::new(room_id)).await?;
+        response
+            .room_state
+            .into_iter()
+            .map(|event| serde_json::to_string(&event).map_err(ClientError::from))
+            .collect()
+    }
